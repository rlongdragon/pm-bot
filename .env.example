# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 只註冊到這個伺服器（開發時立即生效）；留空則全域註冊
DISCORD_GUILD_ID=
# 可以叫 bot 的使用者 id，逗號分隔；留空 = 所有人
# 用 Claude 訂閱登入時只放你自己：官方不允許替其他人透過訂閱發請求
ALLOWED_USER_IDS=
# 可以開關/綁定專案的使用者 id，逗號分隔；留空 = ALLOWED_USER_IDS
ADMIN_USER_IDS=

# ---- 知識庫 ----
# 筆記 repo 位置（bot 會自動 git init）
KNOWLEDGE_DIR=./knowledge
# 專案/綁定/session 狀態檔
STATE_FILE=./data/state.json

# ---- Agent ----
# Claude Code 設定目錄（訂閱登入的 profile），決定用哪個帳號、額度算誰的
# 留空 = bot 啟動當下 ~/.claude-profile 的內容；建議寫死。可以用 ~
CLAUDE_CONFIG_DIR=
# 模型別名或完整 id；留空 = CLI 預設
PM_MODEL=
# 每天幾點巡檢：提醒快到期 / 久未更新的任務（-1 = 不巡檢）
REVIEW_HOUR=9
# reply 某句話並 @bot 時，抓那句之前 / 之後幾則當上下文
CONTEXT_BEFORE=10
CONTEXT_AFTER=5
# 同頻道多久沒互動就開新對話（小時）
SESSION_IDLE_HOURS=3
# 單次 agent 最多幾輪 tool call
MAX_TURNS=40

# ---- 外部來源（/link）----
# GitHub fine-grained token，只給要看的 repo、權限全唯讀（Contents、Issues、Pull requests、Metadata）
# 不設也能看公開 repo，但每小時只有 60 次
GITHUB_TOKEN=
# Notion internal integration（API 權杖），只勾「讀取內容」；在要給它看的頁面 ••• > Connections 加入
NOTION_TOKEN=
# Notion 看板用的 integration（/board）：勾「讀取、更新、插入內容」，只在看板那一頁加入
# 留空 = 用 NOTION_TOKEN（那它就要有寫入權限）
NOTION_BOARD_TOKEN=
# 同一個來源多久內不重抓（分鐘）
SOURCE_MIN_INTERVAL_MIN=10

# ---- 會議錄音（/meet）----
# 音檔放這裡（不進筆記 git）：<dir>/<專案ID>/<時間>_<平台>_<名稱>/
RECORDINGS_DIR=./data/recordings
OPUS_BITRATE=64k
# Google Meet 進會議時顯示的名字
MEET_BOT_NAME=會議記錄員
# 房內只剩 bot 超過幾秒就離開（0 = 不自動離開）
MEET_ALONE_TIMEOUT_SEC=120
# 等主持人放行最多幾秒
MEET_ADMIT_TIMEOUT_SEC=600
# 登入過 Google 的 Chromium profile，要登入才能進的會議用；留空 = 每次全新訪客
MEET_USER_DATA_DIR=
# 1 = 有頭模式（需要桌面或 Xvfb），除錯用
MEET_HEADED=0
