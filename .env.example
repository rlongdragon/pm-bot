# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 只註冊到這個伺服器（開發時立即生效）；留空則全域註冊
DISCORD_GUILD_ID=
# 可以 @bot 問問題 / 用 /ask 的使用者 id，逗號分隔；留空 = 所有人
ALLOWED_USER_IDS=
# 可以開關/綁定專案的使用者 id，逗號分隔；留空 = ALLOWED_USER_IDS
ADMIN_USER_IDS=

# ---- 知識庫 ----
# 筆記 repo 位置（bot 會自動 git init）
KNOWLEDGE_DIR=./knowledge
# 專案/綁定/session 狀態檔
STATE_FILE=./data/state.json

# ---- Agent ----
# Claude Code 設定目錄（訂閱登入的 profile）；留空 = ~/.claude-profile 內容或 ~/.claude
CLAUDE_CONFIG_DIR=
# 模型別名或完整 id；留空 = CLI 預設
PM_MODEL=
# 每隔幾分鐘跑一次整理（0 = 不自動跑，只靠 /digest）
DIGEST_INTERVAL_MIN=15
# 單次 agent 最多幾輪 tool call
MAX_TURNS=40
