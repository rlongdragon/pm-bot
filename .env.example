# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 只註冊到這個伺服器（開發時立即生效）；留空則全域註冊
DISCORD_GUILD_ID=
# 可以叫 bot 的使用者 id，逗號分隔；留空 = 所有人
# 用 Claude 訂閱登入時只放你自己：官方不允許替其他人透過訂閱發請求
ALLOWED_USER_IDS=
# 可以開關/綁定專案的使用者 id，逗號分隔；留空 = ALLOWED_USER_IDS
ADMIN_USER_IDS=

# ---- 知識庫 ----
# 筆記 repo 位置（bot 會自動 git init）
KNOWLEDGE_DIR=./knowledge
# 專案/綁定/session 狀態檔
STATE_FILE=./data/state.json

# ---- Agent ----
# Claude Code 設定目錄（訂閱登入的 profile），決定用哪個帳號、額度算誰的
# 留空 = bot 啟動當下 ~/.claude-profile 的內容；建議寫死。可以用 ~
CLAUDE_CONFIG_DIR=
# 模型別名或完整 id；留空 = CLI 預設
PM_MODEL=
# 每天幾點巡檢：提醒快到期 / 久未更新的任務（-1 = 不巡檢）
REVIEW_HOUR=9
# reply 某句話並 @bot 時，抓那句之前 / 之後幾則當上下文
CONTEXT_BEFORE=10
CONTEXT_AFTER=5
# 同頻道多久沒互動就開新對話（小時）
SESSION_IDLE_HOURS=3
# 單次 agent 最多幾輪 tool call
MAX_TURNS=40
