{
  "name": "pm-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/discord/index.js",
    "dev": "tsx src/discord/index.ts",
    "register": "tsx src/discord/register-commands.ts",
    "pm2:start": "PM2_HOME=.pm2 pm2 start ecosystem.config.cjs",
    "pm2:restart": "PM2_HOME=.pm2 pm2 restart pm-bot",
    "pm2:stop": "PM2_HOME=.pm2 pm2 stop pm-bot",
    "pm2:logs": "PM2_HOME=.pm2 pm2 logs pm-bot"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "libsodium-wrappers": "^0.8.4",
    "playwright": "^1.64.0",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@types/libsodium-wrappers": "^0.7.14"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@discordjs/opus@0.10.0": true
  }
}
